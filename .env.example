# Copy this file to .env and fill in your real values.
# .env is gitignored so secrets never get committed.

# Anthropic API key — paste yours here after the `=` sign (no quotes, no spaces).
# Get one at https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Paths to your Google OAuth files (defaults are fine; don't change unless you renamed them)
GMAIL_CREDS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# Where the generated brief gets saved locally
BRIEF_OUTPUT_DIR=site

# Filled in by setup_agent.py — don't edit by hand.
AGENT_ID=
ENV_ID=
